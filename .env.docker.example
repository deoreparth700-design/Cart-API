# Local Docker development environment template
# Service names 'db' and 'db_test' resolve across containers within the Docker network.

# Application database connection (points to local 'db' PostgreSQL container)
DATABASE_URL=postgresql://cartapi_user:cartapi_password@db:5432/cartapi

# Isolated test database connection (points to local 'db_test' PostgreSQL container)
# Must differ from DATABASE_URL and database name must contain 'test'
TEST_DATABASE_URL=postgresql://cartapi_test_user:cartapi_test_password@db_test:5432/cartapi_test

# Authentication secrets for development
JWT_SECRET=dev_jwt_secret_placeholder_cartapi_32chars_min
JWT_ALGORITHM=HS256

# Razorpay credentials (test placeholders - never use real secrets)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Storefront demo toggle (leave false in development/test environments)
DEMO_MODE=false
